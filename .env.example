# Wallahi Environment Configuration Template
# Copy to .env and configure appropriately

# App Environment
WALLAHI_ENV=development
WALLAHI_LOG_LEVEL=debug

# Optional Processing Server (for heavy point cloud & RF simulations)
WALLAHI_API_HOST=127.0.0.1
WALLAHI_API_PORT=8000
WALLAHI_API_WORKERS=2

# Feature Flags
WALLAHI_ENABLE_WIFI_RTT=true
WALLAHI_ENABLE_CSI_EXPERIMENTAL=false
WALLAHI_HEATMAP_DEFAULT_RESOLUTION=0.25
WALLAHI_HEATMAP_DEFAULT_POWER=2.0
